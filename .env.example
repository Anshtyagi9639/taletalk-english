# Copy this file to .env.local and fill in your own values.
# NEVER put real keys in THIS file. It is committed to git.
# .env.local is ignored by git, so real keys go there.
# --- Free AI (server only, never sent to the browser) ---
# Google Gemini (main AI, free): aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq (backup AI + speech-to-text, free): console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only. Never put NEXT_PUBLIC_ in front of it.
SUPABASE_SECRET_KEY=sb_secret_...
